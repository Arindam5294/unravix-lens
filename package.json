    "proof": "node --no-warnings scripts/meta-proof.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.40.0"
  }
}
