{
  "name": "unravix-lens",
  "version": "0.1.0",
  "private": true,
  "description": "Unravix Lens by Swanix Labs: find the exact knot in handwritten work.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test --no-warnings worker/test/*.test.ts test/web/*.test.mjs",
